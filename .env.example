# Public deployment. Point this hostname at the Droplet before starting
# Traefik: the certificate is obtained over an HTTP-01 challenge, which fails
# while DNS still points somewhere else. Use a real mailbox for Let's Encrypt
# expiry notices.
DOMAIN=sonic.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Published image to run. Override RELAY_IMAGE only when deploying a fork.
RELAY_IMAGE=ghcr.io/hirebarend/sonic-bridge

# Image tag to run, and the tag auto-update follows.
#
# `latest` tracks the default branch: CI re-points it on every push to main, so
# the updater sees a new digest and rolls the relay onto it.
#
# A commit tag such as sha-2e6a4c9 is written once and never moves. Setting one
# pins the deployment and makes auto-update a no-op, because the digest behind
# the tag never changes. That is both the off switch and the way back after a
# bad release. Run `sudo ./scripts/setup-digitalocean.sh --tag sha-2e6a4c9` so
# this file and the running container stay in agreement.
IMAGE_TAG=latest

# Seconds between auto-update checks. Read from this file on every pass, so a
# change takes effect without restarting anything. Set to 0 to park the updater
# and deploy by hand instead.
UPDATE_INTERVAL=300

# Raw TCP port for source ingest, published directly rather than routed through
# Traefik.
#
# This is the relay's ONLY ingest path. Both the ESP32 firmware and the console
# use it, and neither speaks TLS, so audio and the stream header cross the
# network in the clear and anyone who can reach this port can publish to the
# stream. Do not leave it open to the internet: firewall it to the addresses
# your sources use, or keep it closed and reach it through an SSH tunnel:
#
#   ssh -L 9000:127.0.0.1:9000 root@droplet
#   ./bin/console --server 127.0.0.1:9000
TCP_SOURCE_PORT=9000
