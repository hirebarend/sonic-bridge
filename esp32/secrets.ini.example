; Copy to esp32/secrets.ini and fill in. The real file is not tracked by git,
; so credentials never reach a commit.
;
;   cp esp32/secrets.ini.example esp32/secrets.ini

[secrets]
wifi_ssid = your-network-name
wifi_password = your-network-password

; The relay's raw TCP source port. Use the droplet's address once deployed.
; This port is plain TCP, not TLS: the firmware has no TLS stack, so keep it
; on a trusted network or firewalled to the device's address.
relay_host = 192.168.1.10
relay_port = 9000

; Wire format the firmware declares to the relay. mu-law is the only codec the
; relay accepts, so only the rate and frame size are configurable here.
sample_rate = 16000
frame_samples = 320
