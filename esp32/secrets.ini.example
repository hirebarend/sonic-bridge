; Copy this file to `secrets.ini` and fill in your values.
; `secrets.ini` is gitignored.
;
; The single-quoted strings preserve the embedded double quotes so each
; macro arrives at the compiler as a proper C string literal.

[env:esp32-c6-devkitc-1]
build_flags =
    ${common.build_flags}
    '-DSONIC_WIFI_SSID="your-wifi-ssid"'
    '-DSONIC_WIFI_PASS="your-wifi-password"'
    '-DSONIC_SERVER_HOST="192.168.1.50"'
    -DSONIC_SERVER_PORT=9000
